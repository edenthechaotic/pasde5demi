(*exponentiation rapide*) 

let rec expo_rap (x :int) (n : int) = 
  if n = 0 then 1 
  else if n mod 2 = 0 then
    let rep = expo_rap x (n/2) in rep*rep
  else x * expo_rap x (n-1);;


