(*minimum d'un tableau *)

let minimum (tab : int array) : int = 
  let len = Array.length tab in 
  let rep = ref tab.(0) in
  for i = 1 to len - 1 do 
    if tab.(i) < !rep then 
      rep := tab.(i)
    else rep := !rep
  done; 
  !rep;;


