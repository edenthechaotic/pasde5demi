(*méthode de horner ordre croissant des puissances*) 

let horner (coeff : int array) (x : int) = 
  let len = Array.length coeff in 
  let rep = ref coeff.(len-1) in 
  for i = len-2 downto 0 do 
    rep := !rep * x + coeff.(i); 
  done; 
  !rep;;

