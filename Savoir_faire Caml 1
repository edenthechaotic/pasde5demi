(*suite recurrente lineaire type fibo*)
  
let fibonacci (n : int) = 
  if n = 0 then 0 
  else begin
    let a = ref 0 in 
    let b = ref 1 in 
    for _ = 2 to n do 
      let tmp = !a + !b in 
      a := !b; 
      b := tmp; 
    done; 
    !b; 
  end;;
  
  
