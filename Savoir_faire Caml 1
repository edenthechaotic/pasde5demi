(*décomposition en base b*)

let decomposition (n : int) (base : int) = 
  if n = 0 then [0] 
  else let chiffres = ref [] in 
    let n = ref n in 
    while !n > 0 do
      chiffres := (!n mod base)::!chiffres;
      n := !n / base; 
    done; 
    !chiffres;;
  

