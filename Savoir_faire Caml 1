(*produit matriciel naif*) 

type matrice = int array array;;

let produit_mat (a : matrice) (b : matrice) = 
  let n = Array.length a in 
  let p = Array.length b in 
  let q = Array.length a.(0) in 
  let c = Array.make_matrix n q 0 in 
  for i = 0 to n-1 do
    for j = 0 to p-1 do
      for k = 0 to q-1 do 
        c.(i).(j)  <- c.(i).(j) + a.(i).(k) * b.(k).(j); 
      done; 
    done; 
  done; 
  c;;

(*miroir de liste*) 

let miroir liste = 
  let rec aux acc = function
    |[] -> acc 
    |a::q -> aux (a::acc) q
  in aux [] liste;;

miroir [6; 9; 10];;


(*implementation file*)

let creer_file () = ([], []);; 

let est_file_vide (lp, la) = 
  lp = [] && la = [];;

let enfiler (lp, la) x = (x::lp, la);; 

let taille (lp, la) = List.length lp + List.length la;;

let rec transfert = function
  |([],la) -> ([],la)
  |((e::lp),la) -> transfert(lp,e::la);;


let defiler (lp, la) = 
  if est_file_vide (lp, la) then failwith "file vide" 
  else if la <> [] then (List.hd la, (lp, List.tl la))
  else let (lp2, la2) = transfert (lp, la) in
    (List.hd la2, (lp2, List.tl la2));; 

(*parcours en largeur arbre binaire*) 

let largeurbin arbre = 
  let rec largeurbinaux file = 
    if not (est_file_vide file) then begin 
      let (a, reste) = defiler file in 
      match a with 
      |Vide -> largeurbinaux reste
      |Noeubin(g, x, d) -> print_int x; print_string ""; largeurbinaux (enfiler (enfiler reste g) d) 
    end 
  in largeurbinaux (enfiler (creer_file ()) arbre);; 

(*recherche abr*)

let rec recherche a x = match a with
  |Vide -> false 
  |Noeubin(g, e, d) -> if e = x then true 
      else if x < e then recherche g x 
      else recherche d x;; 

(*insertion abr*) 

let rec insertion x = function
  |Vide -> Noeubin(Vide, x, Vide) 
  |Noeubin(g, e, d) -> if x = e then Noeubin(g, x, d) 
      else if x < e then Noeubin (insertion x g, e, d)
      else Noeubin (g, e, insertion x d);; 
