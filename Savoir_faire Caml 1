(*nombre de noeuds et hauteur d'un arbre*) 

type 'a arbre = Noeud of 'a *'a arbre list;;

let rec nb_noeuds = function 
  |Noeud(_, enfants) -> 1 + List.fold_left ( fun acc e -> acc + (nb_noeuds e) ) 0 enfants;;

let rec hauteur  = function 
  |Noeud(_, []) -> 0
  |Noeud(_, enfants) -> 1 + List.fold_left (fun acc e -> acc + (hauteur e)) 0 enfants;;


let arbre_ex =
  Noeud (1, [
      Noeud (2, []);
      Noeud (3, []);
      Noeud (4, [])
    ]);;
  
nb_noeuds arbre_ex;; 
hauteur arbre_ex;;

(*algorithmes arbre binaire*) 
type 'a arbin = Vide | Noeubin of 'a arbin * 'a * 'a arbin;;

(*parcours infixe*)

let rec infixe = function 
  |Vide -> () 
  |Noeubin(g, x, d) -> infixe g; print_int x; print_string ""; infixe d;;

let rec prefixe = function
  |Vide -> ()
  |Noeubin(g, x, d) -> print_int x; print_string ""; prefixe g; prefixe d;; 

let rec suffixe = function 
  |Vide -> ()
  |Noeubin(g, x, d) -> suffixe g; suffixe d; print_string ""; print_int x;;


