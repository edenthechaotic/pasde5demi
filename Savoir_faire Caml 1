(*insertion élément dans liste triée*) 

let rec inserer x = function 
  |[] -> [x] 
  |a::q -> if a > x then x::a::q 
      else a::(inserer x q);;

inserer 3 [2; 4; 7];;

(*dichotomie dans tableau trie*) 

let rec dicho  (t : int array) (x : int) = 
  let len = Array.length t in 
  let deb = ref 0 and fin = ref (len-1) in 
  let rep = ref (-1) in 
  while !deb <= !fin && !rep = -1 do 
    let mid = (!deb + !fin) / 2 in 
    if t.(mid) = x then rep := mid 
    else if t.(mid) < x then deb := mid+1 
    else fin := mid -1
  done; 
  !rep;;
  
  
